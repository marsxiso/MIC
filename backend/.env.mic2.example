# MIC 2.0 backend environment
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=8h
PORT=3001
# Comma-separated exact frontend origins, for example:
# CORS_ORIGIN=https://your-mic-web-domain.example
CORS_ORIGIN=

# Used only by the one-time administrator bootstrap script:
MIC2_ADMIN_LOGIN=
MIC2_ADMIN_PASSWORD=
MIC2_ADMIN_NAME=
